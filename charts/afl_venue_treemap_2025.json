{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Complete 2025 AFL crowd-entry treemap of all 18 venues. Rectangles are rendered in Vega-Lite; major-tile labels are aligned as accessible, non-interactive HTML annotations by the containing website. All 18 rectangles retain exact hover tooltips. Audience measure: crowd entries, not unique spectators.",
  "width": "container",
  "height": 402,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/afl_venue_treemap_2025.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fff",
        "strokeWidth": 2,
        "cornerRadius": 3
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1000
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              800
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "share_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              38
            ],
            "range": [
              "#E5F1ED",
              "#278F84",
              "#075F5D"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "venue",
            "type": "nominal",
            "title": "Venue"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "attendance",
            "type": "quantitative",
            "format": ",.0f",
            "title": "2025 crowd entries"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "format": ".2f",
            "title": "Share within selected geography (%)"
          },
          {
            "field": "games",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Games hosted"
          }
        ]
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelColor": "#526873",
      "titleColor": "#526873",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#E7EEEB"
    },
    "legend": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelColor": "#526873",
      "titleColor": "#15313D"
    }
  },
  "background": null
}
