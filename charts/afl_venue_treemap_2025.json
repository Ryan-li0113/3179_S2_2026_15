{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Treemap of all 18 AFL venues, 2025 attendance including finals, covering 100% of the full 8,257,027 crowd entries, without omitting Other. Area proportional to total attendance and one highlight for MCG. Layout coordinates were computed using a squarified treemap.",
  "width": "container",
  "height": 402,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/afl_venue_treemap_2025.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fff",
        "strokeWidth": 2,
        "cornerRadius": 3
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1000
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              800
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "share_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              38
            ],
            "range": [
              "#E5F1ED",
              "#278F84",
              "#075F5D"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "venue",
            "type": "nominal",
            "title": "Venue"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "attendance",
            "type": "quantitative",
            "format": ",.0f",
            "title": "2025 crowd entries"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "format": ".2f",
            "title": "Share within selected geography (%)"
          },
          {
            "field": "games",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Games hosted"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.show_label == 1"
        },
        {
          "calculate": "(datum.x0+datum.x1)/2",
          "as": "cx"
        },
        {
          "calculate": "(datum.y0+datum.y1)/2",
          "as": "cy"
        },
        {
          "calculate": "datum.venue === 'Melbourne Cricket Ground (MCG)' ? 'MCG' : datum.venue === 'Docklands (Marvel Stadium)' ? 'Marvel Stadium' : datum.venue === 'Perth Stadium (Optus Stadium)' ? 'Optus Stadium' : datum.venue === 'Sydney Cricket Ground (SCG)' ? 'SCG' : datum.venue === 'Kardinia Park (GMHBA Stadium)' ? 'GMHBA Stadium' : datum.venue === 'Carrara (People First Stadium)' ? 'People First Stadium' : datum.venue === 'Sydney Showground (ENGIE Stadium)' ? 'ENGIE Stadium' : datum.venue",
          "as": "short_name"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "font": "Barlow",
        "fontSize": 14,
        "fontWeight": "bold",
        "dy": -10,
        "limit": 170
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1000
            ]
          },
          "axis": null
        },
        "y": {
          "field": "cy",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              800
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "short_name",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.share_pct >= 30",
            "value": "#FFFFFF"
          },
          "value": "#15313D"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.show_label == 1"
        },
        {
          "calculate": "(datum.x0+datum.x1)/2",
          "as": "cx"
        },
        {
          "calculate": "(datum.y0+datum.y1)/2",
          "as": "cy"
        },
        {
          "calculate": "datum.venue === 'Melbourne Cricket Ground (MCG)' ? 'MCG' : datum.venue === 'Docklands (Marvel Stadium)' ? 'Marvel Stadium' : datum.venue === 'Perth Stadium (Optus Stadium)' ? 'Optus Stadium' : datum.venue === 'Sydney Cricket Ground (SCG)' ? 'SCG' : datum.venue === 'Kardinia Park (GMHBA Stadium)' ? 'GMHBA Stadium' : datum.venue === 'Carrara (People First Stadium)' ? 'People First Stadium' : datum.venue === 'Sydney Showground (ENGIE Stadium)' ? 'ENGIE Stadium' : datum.venue",
          "as": "short_name"
        },
        {
          "calculate": "format(datum.share_pct, '.1f')+'%'",
          "as": "share_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "font": "Barlow",
        "fontSize": 12,
        "fontWeight": "normal",
        "dy": 12,
        "limit": 170
      },
      "encoding": {
        "x": {
          "field": "cx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1000
            ]
          },
          "axis": null
        },
        "y": {
          "field": "cy",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              800
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "share_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.share_pct >= 30",
            "value": "#FFFFFF"
          },
          "value": "#15313D"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelColor": "#526873",
      "titleColor": "#526873",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#E7EEEB"
    },
    "legend": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelColor": "#526873",
      "titleColor": "#15313D"
    }
  },
  "background": null
}