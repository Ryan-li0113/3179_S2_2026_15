{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Linked ranked slopegraph. Each line traces a venue between its ranking by season-wide crowd entries and ranking by average crowd per match. State selection recomputes rankings among the venues hosting matches in that state or territory.",
  "width": 1000,
  "height": 390,
  "padding": 0,
  "background": null,
  "data": [
    {
      "name": "ranks",
      "url": "data/afl_venue_rank_shift_interactive_2025.csv",
      "format": {
        "type": "csv",
        "parse": {
          "left_rank": "number",
          "right_rank": "number",
          "total_attendance": "number",
          "average_attendance": "number"
        }
      }
    }
  ],
  "scales": [
    {
      "name": "rankY",
      "type": "linear",
      "domain": [
        0.3,
        8.7
      ],
      "range": [
        72,
        360
      ],
      "zero": false
    }
  ],
  "marks": [
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 337
          },
          "y": {
            "value": 26
          },
          "text": {
            "value": "TOTAL CROWD ENTRIES"
          },
          "font": {
            "value": "Barlow"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#15313D"
          },
          "align": {
            "value": "right"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 816
          },
          "y": {
            "value": 26
          },
          "text": {
            "value": "AVG CROWD PER GAME"
          },
          "font": {
            "value": "Barlow"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#15313D"
          },
          "align": {
            "value": "left"
          }
        }
      }
    },
    {
      "type": "rule",
      "name": "rankGuide",
      "from": {
        "data": "ranks"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 350
          },
          "x2": {
            "value": 805
          },
          "y": {
            "scale": "rankY",
            "field": "left_rank"
          },
          "y2": {
            "scale": "rankY",
            "field": "right_rank"
          },
          "strokeWidth": {
            "value": 2.7
          },
          "stroke": {
            "signal": "datum.venue==='Docklands (Marvel Stadium)'?'#D66B44':'#87ABA4'"
          },
          "tooltip": {
            "signal": "datum.venue+' · total rank '+datum.left_rank+' · per-game rank '+datum.right_rank+' · '+format(datum.total_attendance,',')+' entries · '+format(datum.average_attendance,',')+' avg/game'"
          }
        }
      }
    },
    {
      "type": "symbol",
      "name": "rankLeft",
      "from": {
        "data": "ranks"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 350
          },
          "y": {
            "scale": "rankY",
            "field": "left_rank"
          },
          "size": {
            "value": 145
          },
          "fill": {
            "value": "#087B73"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1.2
          }
        }
      }
    },
    {
      "type": "symbol",
      "name": "rankRight",
      "from": {
        "data": "ranks"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 805
          },
          "y": {
            "scale": "rankY",
            "field": "right_rank"
          },
          "size": {
            "value": 145
          },
          "fill": {
            "value": "#087B73"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1.2
          }
        }
      }
    },
    {
      "type": "text",
      "name": "rankVenue",
      "from": {
        "data": "ranks"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 335
          },
          "y": {
            "scale": "rankY",
            "field": "left_rank"
          },
          "text": {
            "field": "short_name"
          },
          "font": {
            "value": "Barlow"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": "bold"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "#15313D"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "rankNumber",
      "from": {
        "data": "ranks"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 831
          },
          "y": {
            "scale": "rankY",
            "field": "right_rank"
          },
          "text": {
            "signal": "'#'+datum.right_rank"
          },
          "font": {
            "value": "Barlow"
          },
          "fontSize": {
            "value": 15
          },
          "fontWeight": {
            "value": "bold"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "#15313D"
          }
        }
      }
    }
  ]
}