{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Compact slopegraph, top 8 venues by total crowds compared to ranks by average attendance across all 18 AFL venues. One row per rank; coloured focal lines highlight Marvel and Optus.",
  "width": 920,
  "height": 341,
  "padding": 0,
  "background": null,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": [
    {
      "name": "ranks",
      "url": "data/afl_rank_slope_compact_2025.csv",
      "format": {
        "type": "csv",
        "parse": {
          "left_rank": "number",
          "right_rank": "number",
          "avg_crowd": "number",
          "total": "number",
          "games": "number",
          "shift": "number"
        }
      }
    },
    {
      "name": "guides",
      "values": [
        {
          "rank": 1
        },
        {
          "rank": 2
        },
        {
          "rank": 3
        },
        {
          "rank": 4
        },
        {
          "rank": 5
        },
        {
          "rank": 6
        },
        {
          "rank": 7
        },
        {
          "rank": 8
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "ranky",
      "type": "linear",
      "domain": [
        1,
        8
      ],
      "range": [
        65,
        309
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 12
          },
          "y": {
            "value": 28
          },
          "text": {
            "value": "RANK BY TOTAL ENTRIES"
          },
          "font": {
            "value": "Barlow"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#526873"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 722
          },
          "y": {
            "value": 28
          },
          "text": {
            "value": "RANK BY AVERAGE / GAME"
          },
          "font": {
            "value": "Barlow"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#526873"
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "guides"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 220
          },
          "x2": {
            "value": 690
          },
          "y": {
            "scale": "ranky",
            "field": "rank"
          },
          "stroke": {
            "value": "#EDF1EE"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "ranks"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 230
          },
          "x2": {
            "value": 685
          },
          "y": {
            "scale": "ranky",
            "field": "left_rank"
          },
          "y2": {
            "scale": "ranky",
            "field": "right_rank"
          },
          "stroke": {
            "field": "col"
          },
          "strokeWidth": {
            "signal": "datum.shift == 0 ? 2.2 : 3.7"
          },
          "tooltip": {
            "signal": "datum.short+': rank '+datum.left_rank+' for total entries; rank '+datum.right_rank+' for crowd per match ('+ format(datum.avg_crowd,',')+')"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "ranks"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 230
          },
          "y": {
            "scale": "ranky",
            "field": "left_rank"
          },
          "size": {
            "value": 80
          },
          "fill": {
            "field": "col"
          },
          "stroke": {
            "value": "#FFF"
          },
          "strokeWidth": {
            "value": 1.5
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "ranks"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 685
          },
          "y": {
            "scale": "ranky",
            "field": "right_rank"
          },
          "size": {
            "value": 80
          },
          "fill": {
            "field": "col"
          },
          "stroke": {
            "value": "#FFF"
          },
          "strokeWidth": {
            "value": 1.5
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "ranks"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 211
          },
          "y": {
            "scale": "ranky",
            "field": "left_rank"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "field": "label_left"
          },
          "font": {
            "value": "Barlow"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "signal": "datum.shift == 0 ? 'normal':'bold'"
          },
          "fill": {
            "value": "#15313D"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "ranks"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 703
          },
          "y": {
            "scale": "ranky",
            "field": "right_rank"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "field": "label_right"
          },
          "font": {
            "value": "Barlow"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "signal": "datum.shift == 0 ? 'normal':'bold'"
          },
          "fill": {
            "value": "#15313D"
          }
        }
      }
    }
  ]
}
