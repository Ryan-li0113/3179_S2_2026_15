{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Per-match average crowds in AFL home-and-away and finals by season, 2015–2026, AFL Tables. The two phases are comparable average crowd per match; total crowds are not the colour measure. 2020/2021 Covid restrictions affected counts.",
  "width": "container",
  "height": 170,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/afl_season_phase_attendance_2015_2026.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fff",
        "strokeWidth": 3,
        "cornerRadius": 3
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": {
            "title": "AFL season",
            "labelAngle": 0,
            "labelFontSize": 11
          }
        },
        "y": {
          "field": "phase",
          "type": "nominal",
          "sort": [
            "Finals",
            "Home and away"
          ],
          "axis": {
            "title": null,
            "labelFontWeight": "bold",
            "labelPadding": 10
          }
        },
        "color": {
          "field": "average_per_game",
          "type": "quantitative",
          "title": "Avg crowd per match",
          "scale": {
            "domain": [
              0,
              80000
            ],
            "range": [
              "#E7EEEB",
              "#087B73"
            ]
          },
          "legend": {
            "orient": "bottom",
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year",
            "type": "ordinal"
          },
          {
            "field": "phase",
            "title": "Phase",
            "type": "nominal"
          },
          {
            "field": "average_per_game",
            "title": "Average per game",
            "type": "quantitative",
            "format": ",.0f"
          },
          {
            "field": "attendance",
            "title": "Total attendance",
            "type": "quantitative",
            "format": ",.0f"
          },
          {
            "field": "games",
            "title": "Games",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "phase",
          "type": "nominal",
          "sort": [
            "Finals",
            "Home and away"
          ],
          "axis": null
        },
        "text": {
          "field": "average_per_game",
          "type": "quantitative",
          "format": ".2s"
        },
        "color": {
          "condition": {
            "test": "datum.average_per_game >= 48000",
            "value": "#fff"
          },
          "value": "#15313D"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelColor": "#526873",
      "titleColor": "#526873",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#E7EEEB"
    },
    "legend": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelColor": "#526873",
      "titleColor": "#15313D"
    }
  },
  "background": null
}
