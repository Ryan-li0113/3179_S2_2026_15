{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth of the announced 2025 AFL Super Saturday exclusively live coverage windows by Australian state and territory. Not audience size or individual match counts. Foxtel Group, 18 November 2024.",
  "width": "container",
  "height": 425,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/afl_super_saturday_2025.csv",
        "format": {
          "type": "csv",
          "parse": {
            "state_code": "string",
            "exclusive_weeks": "number",
            "label_lon": "number",
            "label_lat": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "state_code",
          "from": {
            "data": {
              "url": "data/australia_states_simplified.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "id"
          },
          "as": "state_geometry"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.6
      },
      "encoding": {
        "shape": {
          "field": "state_geometry",
          "type": "geojson"
        },
        "color": {
          "field": "exclusive_weeks",
          "type": "quantitative",
          "title": "Weeks",
          "scale": {
            "domain": [
              9,
              11,
              25
            ],
            "range": [
              "#DDEFE9",
              "#72B9A9",
              "#087B73"
            ]
          },
          "legend": {
            "title": "2025 exclusively live Saturday coverage (weeks)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 260,
            "values": [
              9,
              11,
              25
            ],
            "labelFontSize": 12,
            "titleFontSize": 12,
            "titlePadding": 10
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "exclusive_weeks",
            "type": "quantitative",
            "title": "Exclusive-live weeks",
            "format": ".0f"
          },
          {
            "field": "season",
            "type": "nominal",
            "title": "AFL season"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/afl_super_saturday_2025.csv",
        "format": {
          "type": "csv",
          "parse": {
            "state_code": "string",
            "exclusive_weeks": "number",
            "label_lon": "number",
            "label_lat": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.abbreviation !== 'ACT'"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Barlow",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#15313D",
        "stroke": "#ffffff",
        "strokeWidth": 1.6,
        "paintOrder": "stroke"
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "abbreviation",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelColor": "#526873",
      "titleColor": "#15313D"
    },
    "axis": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelColor": "#526873",
      "titleColor": "#526873",
      "gridColor": "#E7EEEB"
    }
  },
  "background": null
}
