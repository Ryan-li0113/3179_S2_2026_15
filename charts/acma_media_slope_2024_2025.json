{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope chart contrasting 2024 and 2025 weekly adult use of four video formats. Consistent medium colours are shared with Figure 7.",
  "width": "container",
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/acma_media_2024_2025.csv"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "sort": [
        2024,
        2025
      ],
      "axis": {
        "title": "ACMA survey year",
        "labelAngle": 0
      }
    },
    "y": {
      "field": "share_pct",
      "type": "quantitative",
      "scale": {
        "domain": [
          40,
          75
        ]
      },
      "axis": {
        "title": "Adults watching in the previous week (%)",
        "values": [
          40,
          45,
          50,
          55,
          60,
          65,
          70,
          75
        ],
        "labelExpr": "datum.value+'%'"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3.5,
        "point": {
          "filled": true,
          "size": 125
        }
      },
      "encoding": {
        "detail": {
          "field": "media"
        },
        "color": {
          "field": "media",
          "type": "nominal",
          "scale": {
            "domain": [
              "Paid streaming",
              "Broadcast FTA TV",
              "Short-form online video",
              "Catch-up FTA TV"
            ],
            "range": [
              "#2B5E86",
              "#A27B3D",
              "#7B6A9A",
              "#6B9588"
            ]
          },
          "legend": {
            "title": "Video format",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "media",
            "type": "nominal",
            "title": "Medium"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Weekly reach (%)",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "dx": 0,
        "dy": -12
      },
      "encoding": {
        "text": {
          "field": "share_pct",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "field": "media",
          "type": "nominal",
          "scale": {
            "domain": [
              "Paid streaming",
              "Broadcast FTA TV",
              "Short-form online video",
              "Catch-up FTA TV"
            ],
            "range": [
              "#2B5E86",
              "#A27B3D",
              "#7B6A9A",
              "#6B9588"
            ]
          },
          "legend": {
            "title": "Video format",
            "orient": "bottom",
            "direction": "horizontal"
          }
        }
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelColor": "#526873",
      "titleColor": "#526873",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#E7EEEB"
    },
    "legend": {
      "labelFont": "Barlow",
      "titleFont": "Barlow",
      "labelColor": "#526873",
      "titleColor": "#15313D"
    }
  },
  "background": null
}
