{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Estimated Australians aged 14+ watching AFL and NRL on television, Roy Morgan Single Source survey, July 2025-June 2026. NRL count is rounded by source. Choose AFL or NRL to emphasise one series while keeping the comparison visible.",
  "data": {
    "url": "data/afl_nrl_tv_2026.csv",
    "format": {
      "type": "csv"
    }
  },
  "width": "container",
  "height": 168,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "encoding": {
    "y": {
      "field": "sport",
      "type": "nominal",
      "sort": [
        "AFL",
        "NRL"
      ],
      "axis": {
        "title": null,
        "domain": false,
        "ticks": false,
        "labelColor": "#102c37",
        "labelFontSize": 16,
        "labelFontWeight": "bold",
        "labelPadding": 14
      }
    },
    "x": {
      "field": "viewers_million",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          11
        ],
        "nice": false
      },
      "axis": {
        "title": "Australians aged 14+ who watched on TV (millions)",
        "values": [
          0,
          2,
          4,
          6,
          8,
          10
        ],
        "labelExpr": "datum.value + 'm'",
        "grid": true,
        "gridColor": "#e4ebe8",
        "domain": false,
        "tickColor": "#9ab5b0",
        "labelFontSize": 12,
        "titleFontSize": 13,
        "titlePadding": 18
      }
    },
    "opacity": {
      "condition": {
        "test": "sportFocus === 'Both sports' || datum.sport === sportFocus",
        "value": 1
      },
      "value": 0.18
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 48,
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "color": {
          "field": "sport",
          "type": "nominal",
          "scale": {
            "domain": [
              "AFL",
              "NRL"
            ],
            "range": [
              "#087b73",
              "#d66b44"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "sport",
            "type": "nominal",
            "title": "Sport"
          },
          {
            "field": "audience_label",
            "type": "nominal",
            "title": "Estimated TV audience"
          },
          {
            "field": "survey_period",
            "type": "nominal",
            "title": "Survey period"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 9,
        "font": "Barlow",
        "fontWeight": "bold",
        "fontSize": 16,
        "color": "#102c37"
      },
      "encoding": {
        "text": {
          "field": "audience_label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Barlow",
      "titleFont": "Barlow"
    },
    "bar": {
      "tooltip": true
    }
  },
  "params": [
    {
      "name": "sportFocus",
      "value": "Both sports"
    }
  ]
}
